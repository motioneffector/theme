{
  "name": "@motioneffector/theme",
  "version": "1.0.1",
  "description": "Type-safe theme management with CSS variables, runtime switching, and persistence support",
  "author": "motioneffector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/motioneffector/theme"
  },
  "homepage": "https://github.com/motioneffector/theme#readme",
  "bugs": {
    "url": "https://github.com/motioneffector/theme/issues"
  },
  "keywords": [
    "theme",
    "theming",
    "css-variables",
    "dark-mode",
    "color-scheme",
    "typescript",
    "theme-manager",
    "css-custom-properties",
    "theme-switching",
    "ui-theming"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:manual",
    "build:manual": "node scripts/build-manual.cjs",
    "test": "vitest",
    "test:run": "vitest run --exclude src/fuzz.test.ts",
    "fuzz:thorough": "FUZZ_THOROUGH=1 vitest run src/fuzz.test.ts --testTimeout=10000",
    "lint": "eslint src",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/browser": "^2.1.8",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "marked": "^12.0.2",
    "prettier": "^3.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
